{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.hevyapp.com/*" },
        { "url": "https://world.openfoodfacts.org/*" },
        { "url": "https://api.nal.usda.gov/*" }
      ]
    }
  ]
}
