{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Speckweg Beta",
  "identifier": "com.bakaruu.speckweg.beta",
  "app": {
    "windows": [
      {
        "title": "Speckweg Beta",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons-beta/32x32.png",
      "icons-beta/128x128.png",
      "icons-beta/128x128@2x.png",
      "icons-beta/icon.icns",
      "icons-beta/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bakaruu/Speckweg/releases/download/beta/latest.json"
      ]
    }
  }
}
